+"""
+    validate_financing(fin::FinancingStructure) -> Bool
+
+Validate that a FinancingStructure is internally consistent.
+
+Returns `true` when:
+- `equity_pct + debt_pct + grant_pct` equals 1.0 within 1e-6
+- Every share (`equity_pct`, `debt_pct`, `grant_pct`) is non-negative
+- `debt_interest` is non-negative
+- `debt_tenor_years` >= 1
+- `equity_irr_target` is non-negative
+
+Returns `false` otherwise (no exception thrown).
+"""
+function validate_financing(fin::FinancingStructure)
+    # Check shares sum to 1.0
+    abs(fin.equity_pct + fin.debt_pct + fin.grant_pct - 1.0) > 1e-6 && return false
+    # Check non-negativity
+    fin.equity_pct < 0.0 && return false
+    fin.debt_pct < 0.0 && return false
+    fin.grant_pct < 0.0 && return false
+    fin.debt_interest < 0.0 && return false
+    fin.equity_irr_target < 0.0 && return false
+    # Check tenor
+    fin.debt_tenor_years < 1 && return false
+    return true
+end
+
+"""
+    compute_debt_schedule(capex::Float64, fin::FinancingStructure) -> Vector{NamedTuple}
+
+Compute the full amortization schedule for the debt portion of a CAPEX.
+
+Returns one NamedTuple per year (1 .. debt_tenor_years), each with fields:
+- `year::Int`
+- `payment::Float64`   — total annual payment (annuity)
+- `interest::Float64`  — interest portion of payment
+- `principal::Float64` — principal portion of payment
+- `balance::Float64`   — remaining debt after payment
+
+Uses the same annuity formula as `compute_debt_service`. At zero interest the
+payment is straight-line principal (debt_amount / tenor). The final balance is
+zero within 1e-6 and the sum of principal equals the debt amount.
+"""
+function compute_debt_schedule(capex::Float64, fin::FinancingStructure)
+    debt_amount = capex * fin.debt_pct
+    r = fin.debt_interest
+    n = fin.debt_tenor_years
+
+    # Annuity (same formula as compute_debt_service)
+    annuity = if r > 0.0
+        debt_amount * r * (1.0 + r)^n / ((1.0 + r)^n - 1.0)
+    else
+        debt_amount / n
+    end
+
+    schedule = Vector{NamedTuple{(:year, :payment, :interest, :principal, :balance),
+                                 Tuple{Int, Float64, Float64, Float64, Float64}}}(undef, n)
+    balance = debt_amount
+
+    for y in 1:n
+        interest = balance * r
+        principal = annuity - interest
+        # Clamp final principal to avoid tiny floating-point drift
+        if y == n
+            principal = balance
+        end
+        balance -= principal
+        schedule[y] = (year=y, payment=annuity, interest=interest,
+                       principal=principal, balance=balance)
+    end
+
+    return schedule
+end
+
+"""
+    total_interest_paid(capex::Float64, fin::FinancingStructure) -> Float64
+
+Return the sum of the interest column of `compute_debt_schedule`.
+"""
+function total_interest_paid(capex::Float64, fin::FinancingStructure)
+    schedule = compute_debt_schedule(capex, fin)
+    return sum(entry.interest for entry in schedule)
+end
+
+"""
+    print_debt_schedule(capex::Float64, fin::FinancingStructure)
+
+Print the debt amortization schedule as a formatted table.
+"""
+function print_debt_schedule(capex::Float64, fin::FinancingStructure)
+    schedule = compute_debt_schedule(capex, fin)
+    println("="^75)
+    println("DEBT AMORTIZATION SCHEDULE")
+    println("="^75)
+    @printf("  Debt amount:   €%.2f M\n", capex * fin.debt_pct / 1e6)
+    @printf("  Interest rate: %.2f%%\n", fin.debt_interest * 100)
+    @printf("  Tenor:         %d years\n", fin.debt_tenor_years)
+    println("-"^75)
+    @printf("%4s | %12s | %12s | %12s | %12s\n",
+            "Year", "Payment €", "Interest €", "Principal €", "Balance €")
+    println("-"^75)
+    for entry in schedule
+        @printf("%4d | %12.0f | %12.0f | %12.0f | %12.0f\n",
+                entry.year, entry.payment, entry.interest,
+                entry.principal, entry.balance)
+    end
+    println("="^75)
+    total_int = total_interest_paid(capex, fin)
+    @printf("  Total interest paid: €%.2f M\n", total_int / 1e6)
+    println("="^75)
+end
