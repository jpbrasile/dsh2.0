+"""
+    validate_financing(fin::FinancingStructure) -> Bool
+
+Validate a financing structure. Returns `false` on any failure; never throws.
+
+Checks:
+- `equity_pct + debt_pct + grant_pct ~= 1.0` (within 1e-6)
+- each share >= 0
+- each rate (`debt_interest`, `equity_irr_target`) >= 0
+- `debt_tenor_years >= 1`
+"""
+function validate_financing(fin::FinancingStructure) -> Bool
+    isapprox(fin.equity_pct + fin.debt_pct + fin.grant_pct, 1.0, atol=1e-6) || return false
+    fin.equity_pct >= 0 || return false
+    fin.debt_pct >= 0 || return false
+    fin.grant_pct >= 0 || return false
+    fin.debt_interest >= 0 || return false
+    fin.equity_irr_target >= 0 || return false
+    fin.debt_tenor_years >= 1 || return false
+    return true
+end
+
+"""
+    compute_debt_schedule(capex::Float64, fin::FinancingStructure) -> Vector{NamedTuple}
+
+Build the amortizing debt repayment schedule for a CAPEX amount under a
+financing structure. Uses the same annuity formula as `compute_debt_service`:
+equal annual payments over `debt_tenor_years` years. Each entry of the returned
+`Vector{NamedTuple}` carries `(year, payment, interest, principal, balance)`
+where `balance` is the outstanding balance after that year's payment. The final
+balance is zero (within 1e-6) and the sum of principal equals the debt amount
+(within 1e-6) by construction of the annuity formula.
+"""
+function compute_debt_schedule(capex::Float64, fin::FinancingStructure) -> Vector{NamedTuple{(:year, :payment, :interest, :principal, :balance), Tuple{Int, Float64, Float64, Float64, Float64}}}
+    debt_amount = capex * fin.debt_pct
+    r = fin.debt_interest
+    n = fin.debt_tenor_years
+
+    # Annuity formula (same as compute_debt_service)
+    if r > 0
+        annuity = debt_amount * r * (1 + r)^n / ((1 + r)^n - 1)
+    else
+        annuity = debt_amount / n
+    end
+
+    schedule = Vector{NamedTuple{(:year, :payment, :interest, :principal, :balance), Tuple{Int, Float64, Float64, Float64, Float64}}}(undef, n)
+    balance = debt_amount
+    for t in 1:n
+        interest = balance * r
+        principal = r > 0 ? annuity - interest : annuity
+        balance -= principal
+        # Round to zero on the final year to absorb floating-point drift
+        if t == n
+            balance = 0.0
+        end
+        schedule[t] = (; year=t, payment=annuity, interest=interest,
+                        principal=principal, balance=balance)
+    end
+    return schedule
+end
+
+"""
+    total_interest_paid(capex::Float64, fin::FinancingStructure) -> Float64
+
+Total interest paid over the life of the debt for a CAPEX amount under a
+financing structure.
+"""
+function total_interest_paid(capex::Float64, fin::FinancingStructure) -> Float64
+    schedule = compute_debt_schedule(capex, fin)
+    return sum(s.interest for s in schedule)
+end
