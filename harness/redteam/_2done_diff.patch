+"""
+    print_debt_schedule(capex::Float64, fin::FinancingStructure)
+
+Print the amortizing debt repayment schedule for a CAPEX amount.
+"""
+function print_debt_schedule(capex::Float64, fin::FinancingStructure)
+    schedule = compute_debt_schedule(capex, fin)
+    println("="^80)
+    println("DEBT REPAYMENT SCHEDULE")
+    @printf("  Debt amount: €%.2f M | Interest: %.2f%% | Tenor: %d years\n",
+        capex * fin.debt_pct / 1e6, fin.debt_interest * 100, fin.debt_tenor_years)
+    println("="^80)
+    @printf("%5s | %12s | %12s | %12s | %12s\n",
+        "Year", "Payment €M", "Interest €M", "Principal €M", "Balance €M")
+    println("-"^80)
+
+    total_payment = 0.0
+    total_interest = 0.0
+    total_principal = 0.0
+    for s in schedule
+        @printf("%5d | %12.4f | %12.4f | %12.4f | %12.4f\n",
+            s.year, s.payment / 1e6, s.interest / 1e6, s.principal / 1e6, s.balance / 1e6)
+        total_payment += s.payment
+        total_interest += s.interest
+        total_principal += s.principal
+    end
+
+    println("-"^80)
+    @printf("%5s | %12.4f | %12.4f | %12.4f | %12s\n",
+        "TOTAL", total_payment / 1e6, total_interest / 1e6,
+        total_principal / 1e6, "-")
+    println("="^80)
+end
+
